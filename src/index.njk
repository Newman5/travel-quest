---
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Travel Quest</title>
    <link rel="stylesheet" href="{{ '/assets/styles.css' | url }}">
  </head>
  <body>
    <div class="app-shell">
      <main class="planner-board">
        <section class="panel days-panel" aria-labelledby="days-title">
          <div class="panel-header">
            <h2 id="days-title">Days</h2>
            <div class="panel-header-actions">
              <input id="new-day-date" type="date" aria-label="Day date">
              <button id="add-day-button" type="button" class="icon-button primary-icon-button" aria-label="Add day">+</button>
            </div>
          </div>
          <div id="days-jump" class="days-jump" aria-label="Jump to day"></div>
          <div id="days-container" class="days-container" aria-live="polite"></div>
        </section>

        <section class="panel library-panel" aria-labelledby="library-title">
          <div class="panel-header">
            <h2 id="library-title">Quest Library</h2>
            <div class="panel-header-actions">
              <input id="library-filter" type="text" placeholder="Search quests" aria-label="Search quests">
              <button id="archive-trip-button" type="button" class="secondary-button">Archive trip</button>
              <button id="add-quest-button" type="button" class="icon-button primary-icon-button" aria-label="Add quest">+</button>
            </div>
          </div>
          <div id="quest-library" class="quest-library" aria-live="polite"></div>
        </section>

        <section class="panel history-panel" aria-labelledby="history-title">
          <div class="panel-header">
            <h2 id="history-title">History</h2>
          </div>
          <div class="history-columns">
            <div>
              <h3>Archived Days</h3>
              <div id="archived-days-list" class="archive-list"></div>
            </div>
            <div>
              <h3>Archived Trips</h3>
              <div id="archived-trips-list" class="archive-list"></div>
            </div>
          </div>
        </section>
      </main>
    </div>

    <dialog id="quest-detail-dialog" class="quest-dialog">
      <div class="dialog-header">
        <h3 id="quest-detail-title">Quest details</h3>
        <button id="close-detail-dialog" type="button" class="close-button" aria-label="Close">×</button>
      </div>
      <div id="quest-detail-content" class="quest-detail-content"></div>
    </dialog>

    <dialog id="add-quest-dialog" class="quest-dialog">
      <div class="dialog-header">
        <h3 id="add-quest-title">Add quest</h3>
        <button id="close-add-quest-dialog" type="button" class="close-button" aria-label="Close">×</button>
      </div>
      <form id="add-quest-form" class="quest-form">
        <input id="quest-target-day-id" name="targetDayId" type="hidden" value="">
        <label>
          Name
          <input id="quest-name" name="name" type="text" required>
        </label>
        <label>
          Location
          <input id="quest-location" name="location" type="text">
        </label>
        <label>
          Notes
          <textarea id="quest-notes" name="notes" rows="3"></textarea>
        </label>
        <label>
          Link
          <input id="quest-link" name="link" type="url" placeholder="https://example.com">
        </label>
        <div class="form-actions">
          <button type="submit" class="primary-button">Save quest</button>
        </div>
      </form>
    </dialog>

    <dialog id="action-menu-dialog" class="quest-dialog action-menu-dialog">
      <div class="dialog-header">
        <h3 id="action-menu-title">Options</h3>
        <button id="close-action-menu-dialog" type="button" class="close-button" aria-label="Close">×</button>
      </div>
      <div id="action-menu-actions" class="action-menu-actions"></div>
    </dialog>

    <script type="application/json" id="travel-quest-seed">{{ travelQuestSeed | dump | safe }}</script>
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>
    <script type="module" src="{{ '/assets/app.js' | url }}"></script>
  </body>
</html>
